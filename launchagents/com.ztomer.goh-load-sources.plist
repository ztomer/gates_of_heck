<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ztomer.goh-load-sources</string>

    <!-- The load-sources sampler (GOH.LOADSOURCES, 2026-11-17). The gates in the queue averaged
         2.89 cores over a day whose median 1-minute load was 69.6 on 16 cores, and nothing
         recorded what the rest was. Every 30 s lib/load_sources.py reads the process table
         (libproc and ps, no privilege, read only: it never signals anything) and appends one line
         of cpu-s by process family, repo and executable name to the ledger the `goh load` report
         ranks. It exits after an hour and KeepAlive starts the next, so each hour runs the newest
         committed sampler (tools/load_sources.sh runs an export of HEAD). Its own cost is in
         every line (`self_s`): about 0.3% of one core. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <!-- path-ok: launchd execs this with no shell and no environment, so an absolute path is the only form it can use. The guard is quiet until the gates checkout carries the sampler. -->
        <string>p=/Users/ztomer/Projects/gates_of_heck/tools/load_sources.sh; [ -x "$p" ] || exit 0; exec "$p" --interval 30 --for 3600</string>
    </array>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>Nice</key>
    <integer>5</integer>

    <key>WorkingDirectory</key>
    <!-- path-ok: the gates checkout, so the job resolves the house interpreter and the HEAD export cache. -->
    <string>/Users/ztomer/Projects/gates_of_heck</string>

    <key>LowPriorityIO</key>
    <true/>

    <key>StandardOutPath</key>
    <!-- path-ok: launchd opens this file itself and does not expand `~`, so the path must be absolute. -->
    <string>/Users/ztomer/Library/Logs/goh-load-sources.log</string>
    <key>StandardErrorPath</key>
    <!-- path-ok: the same file as StandardOutPath, for the same reason. -->
    <string>/Users/ztomer/Library/Logs/goh-load-sources.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>NO_COLOR</key><string>1</string>
    </dict>
</dict>
</plist>
