#!/usr/bin/env bash
# pre-push — runs the FULL gate on the COMMIT being pushed, in a clean worktree.
# Installed by gates_of_heck/install.sh. There is no CI behind this; if this
# hook is skipped, it is not run. The logic lives in gates_of_heck (push_gate.sh)
# so a fix there reaches every repo without a re-install.
set -euo pipefail

GOH="${GOH_DIR:-${GOH:-$HOME/Projects/gates_of_heck}}"
exec bash "$GOH/gates/push_gate.sh" "$@"
