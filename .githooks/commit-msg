#!/bin/bash
# commit-msg — gates_of_heck's commit-message rule (gates/commit_msg.sh), inert unless the repo's
# .gatesrc sets GOH_COMMIT_CLASS. Installed by gates_of_heck/install.sh; delegates to the shared
# checkout, vendoring nothing.
{ # parse-guard -- bash reads this group whole before running it (tests/test_parse_guard.py)
set -euo pipefail
# A GOH_DIR naming a REMOVED HEAD export (inherited by a long-lived process) falls back to a live
# gates_of_heck: lib/goh_root.sh's rule, copied verbatim (tests/test_dead_goh_dir.py; GOH.TRANSIENTDIR).
goh_dir_repair() {
    [ -n "${GOH_DIR:-}" ] && [ ! -d "$GOH_DIR" ] || return 0
    local c
    for c in "${GOH_LIVE_ROOT:-}" "$HOME/Projects/gates_of_heck"; do
        if [ -n "$c" ] && [ -d "$c/gates" ]; then
            echo "⚠ gates_of_heck: GOH_DIR=$GOH_DIR no longer exists (a pruned HEAD export this" \
                "process inherited; restart it) -- using $c" >&2
            export GOH_DIR="$c"
            return 0
        fi
    done
    return 0
}
goh_dir_repair
GOH="${GOH_DIR:-${GOH:-$HOME/Projects/gates_of_heck}}"
[ ! -f "$GOH/lib/bash5.sh" ] || { . "$GOH/lib/bash5.sh" && goh_bash5 "$@"; }   # an older GOH has none
runner="$GOH/gates/commit_msg.sh"
if [ ! -d "$GOH/gates" ]; then
    echo "✗ commit-msg: cannot find gates_of_heck at $GOH (set GOH_DIR or run its install.sh)" >&2
    exit 1
fi
if [ ! -f "$runner" ]; then
    # A gates checkout older than the rule: there is no rule there to run, and saying so beats
    # refusing every commit of every repo that reinstalled from a newer one.
    echo "⚠ commit-msg: $GOH predates gates/commit_msg.sh -- the commit-class rule did not run" >&2
    exit 0
fi
exec bash "$runner" "$1"
exit
} # parse-guard
