# gates_of_heck configuration. All keys optional; delete what you don't use.
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# GOH_LINE_EXCLUDE='third_party/|\.generated\.'
# GOH_PY_COV_MIN=95
# GOH_SWIFT_MODE=xcode            # or spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25           # disk-hygiene ceiling (full runs only)

# The skills-corpus gate over ~/.claude/skills, the corpus this repo's checker
# exists for. It was wired here when that corpus had no repo of its own ("if it
# is not wired here it is wired nowhere"). It now has one, gated by its own
# pre-commit hook -- which, since 2026-09-23, checks the INDEX at --staged.
#
# The corpus is no part of any commit HERE, so pre-commit skips it by name
# ("outside this repo ... NOT checked at --staged"): a violation there could
# only ever be a false red on a gates_of_heck diff, and it was one -- other
# sessions' unstaged skill edits blocked commits here. --full reads the corpus
# at its last COMMIT (it is its own repository), so a push here says when the
# corpus's committed state is broken -- never another session's edit in progress.
GOH_SKILLS_CORPUS=1

# No process kill by name (`goh kill-by-name`). The CadGoose profiling
# scripts and the release kit's update_dev.sh still kill by name; they are in
# kill_by_name_allow.json as `unreviewed`, with the gate's own pattern as the
# one `legitimate` entry.
GOH_NO_KILL_BY_NAME=1

# No early-exit consumer on a pipe under pipefail (`goh early-exit-pipe`). The step runs in every
# repo with the ratchet open (a NEW racy pipe refused at commit); this repo's tree is clean, so it
# closes the ratchet and every finding fails.
GOH_NO_EARLY_EXIT_PIPE=1

# Every process call declares its stdin (`goh subprocess-stdin`). This repo owns the check and
# carried half the estate's findings (511 of 996, 2026-10-09); every call now names `stdin=` or
# `input=`, with no allowlist, so it opts in ahead of the default flip (BACKLOG 3.4). The floor is
# the fourth vacuous pass: 614 calls were read on 2026-10-13, and a scan that stops seeing them is
# red rather than clean.
GOH_SUBPROCESS_STDIN=on
GOH_SUBPROCESS_STDIN_MIN_CALLS=550

# Every tracked JavaScript source parses (`goh js-syntax`). This tree holds no JavaScript, so the
# step says "not applicable" here -- and says it, rather than passing silently, which is the point
# of the key: a repository that DOES carry JavaScript writes `on` and gets the check. The two
# engines are `node --check` and macOS's JavaScriptCore; the second one needs nothing installed.
# No floor here: there is no subject to floor (0 files is the whole of it).
GOH_JS_SYNTAX=on

# Every scanner's floor (BACKLOG 4.3, crates/goh/src/subject.rs): a full-scope scan that reads
# less than this is red, because a scan that stopped reading its subject reports clean. Set at
# about nine tenths of what each read on 2026-10-13 (in brackets), as the stdin floor above is:
# a file or two deleted is not a red gate, a filter or parser that stopped matching is. Lower one
# with the tree in the same commit. No workflows here, so checkout-credentials carries none.
GOH_EMOJI_MIN_FILES=570                 # [637] text files
GOH_CONFLICT_MARKERS_MIN_FILES=570      # [637] files
GOH_FILE_LENGTH_MIN_FILES=520           # [582] files measured
GOH_SECRETS_MIN_FILES=570               # [637] text files
GOH_SHELL_LINT_MIN_FILES=60             # [70] shell files
GOH_BUSY_LOOP_MIN_FILES=60              # [68] shell sources the busy-loop check reads
GOH_EARLY_EXIT_PIPE_MIN_FILES=65        # [75] shell sources
GOH_DEAD_AFTER_EXEC_MIN_FILES=65        # [75] shell sources
GOH_BARE_HOOK_INDEX_MIN_FILES=65        # [75] shell sources
GOH_BARE_PYTHON_MIN_FILES=5             # [6] hook/gate scripts
GOH_TAP_WRITES_MIN_FILES=370            # [414] script/workflow files (2026-10-17)
GOH_MOVING_TAGS_MIN_REFS=0              # [0] image references -- this tree builds and pulls no image
GOH_MD_LINKS_MIN_LINKS=1                # [1] markdown links -- this tree cites by path, not link
GOH_UNREAPED_SPAWN_MIN_FILES=300        # [337] test files
GOH_STATUS_MARKERS_MIN_FILES=510        # [568] source files (a GOH_CI_STEPS step)
GOH_SKILLS_ROOT=$HOME/.claude/skills

# COVERAGE FLOOR for crates/goh: 95, the house floor. Measured 97.91% on
# 2026-09-14 once crates/goh/tests/cli.rs drove the binary end to end over
# fixture repos -- the same exercise the Python parity suites give it from
# pytest, where llvm-cov cannot see it. Ratchet: up only.
GOH_COV_FLOOR_RUST=95
# The native checks' behaviour suite is the pytest suite (Phase N3: it drives `goh` from outside
# cargo test), so the coverage gate also runs it against the INSTRUMENTED binary and counts it.
# Without it the crate read 62.5% (2026-10-06) for code the suite covers.
GOH_COV_RUST_EXTERNAL='GOH_TEST_BIN="$GOH_COVERAGE_BIN_DIR/goh" ./tools/pytest.sh'

# A number in prose, re-derived from the tree (`goh claim-derivation`). Opt-in
# in every repo because it lands RED wherever it lands first: three adversarial
# reviews of the games estate found the same class six times (a docstring claiming
# "64 declared gates" against 70, a gate claiming "477 lines and 18 tests" for
# 321 and 20), every one of them found by hand at hours each.
#
# This repo opts in, and the claim it polices is its OWN: `checks/_retired.py`'s
# docstring marks how many forwarders `SHIMS` holds, and this step re-derives it
# (the claim moved there when Phase N3 deleted the Python checker that carried it).
GOH_CLAIM_DERIVATION=1

# The gate of record. `tools/gate.sh --full` (the pre-push hook) delegates to
# gates/local_ci.sh, which reads this -- ONE list. This repo IS the gates, so
# its list is the house Rust gate over crates/goh (whose biting cargo audit reads goh's locked
# copy of the advisory database -- a second, bare `cargo audit` step here refreshed the shared
# one under the test suite's reads and tore them, 2026-10-12), the structural gates over itself,
# cargo test, and the pytest suite (which is what stands between a gate bug and every consumer;
# parallel under xdist with --dist loadgroup, see docs/contracts.md) -- the last two inside the
# Rust gate's coverage group, once (below).
export GOH_DIR="${GOH_DIR:-$HOME/Projects/gates_of_heck}"
# Python shape, decided by a DECLARED rule set: pyproject.toml pins ruff's
# line-length to 100 (matching rustfmt.toml). Opt-in for every repo; this
# one has chosen its rule set, so it opts in. Without a configuration ruff
# applied defaults and the shape of each file was decided by whichever hand
# last edited it -- and no gate here ever ran the check over this tree.
GOH_PYTHON_FORMATTED=1
# THIS repo is the gates, so every step names ITS OWN tree (./), never $GOH_DIR: the push runs in
# a worktree of the pushed commit, and GOH_DIR there is the shared checkout's HEAD export (C4) --
# the v0.22.0 push ran that export's tests, outside any git repo (tests/test_gates_from_head.py).
# The structural gate gives one verdict however the tree's path is spelled (gates/path_invariance.py):
# the push gate runs it from a scratch export under /var/folders, which is also /private/var/folders.
# THE SUITE RUNS ONCE PER GATE (G2e, 2026-10-25). It ran TWICE side by side: as its own step, and
# inside rust_gate.sh's coverage group over the instrumented binary (GOH_COV_RUST_EXTERNAL above),
# which is the same suite, the same tests, judged the same way -- a failing test there is a missing
# coverage part and a red step (tests/test_coverage_external.py). So that run IS the suite step,
# and `cargo test --workspace` likewise: the coverage group runs every lib, bin and test target of
# the workspace with --all-features, which leaves only doctests, run here on their own (`--doc`).
# checks/_calibration.py's runs_pytest() counts the coverage route, so a test cited as a proof is
# still a proof that runs on every push (tests/test_suite_runs_once.py pins the list's shape).
GOH_CI_STEPS='./gates/rust_gate.sh:./gates/structural.sh --full:cargo test --workspace --doc --locked:./gates/goh.sh status-markers:"$GOH_PY" ./gates/path_invariance.py -- ./gates/structural.sh --full'
# How many of those steps run at once. Serial is the default because only a repo can say which of
# its steps write the same file, so each candidate here was CLOSED rather than assumed (measured
# 2026-10-16):
#   * ADVISORY DATABASE: not shared. `lib/advisory_db.py` gives every goh audit a copy of its own
#     (`GOH_ADVISORY_DB`) under a flock -- shared to read, exclusive to refresh -- so a refresh
#     waits for readers and readers wait for it. The 2026-10-12 tear came from a SECOND, BARE
#     `cargo audit` step here, which is no longer in the list above; every audit this list still
#     runs goes through that seam, so none of them can tear another.
#   * `crates/goh/target`: cargo locks it itself, so rust_gate.sh, `cargo test --workspace --doc`
#     and the coverage sub-step serialise on it by themselves, with no tag to declare.
#   * the two `./gates/structural.sh --full` runs: the second is path_invariance.py's, and it
#     clones HEAD into its own `tempfile.mkdtemp()` and runs there, never in this tree.
# Measured with GOH_PROVEN=0 (so no step could be skipped) and GOH_TIMINGS on, twice, at HEAD:
# 210 s serial, 176 s at 2, 158 s at 4, green throughout, and the 176/158 pair reproduced within
# 3 s in both sweeps. A serial arm measured at 243 s is NOT used -- the box still carried unrelated
# load for it. 2 is the knee: it takes 65% of the saving, and 4 buys 10% more for twice the peak
# load. Note the steps themselves get SLOWER under concurrency and the wall is still lower: the
# pytest suite runs 85 s alone and 142 s beside the twin this list gave it.
# Re-measured for G2e (2026-10-25, GOH_PROVEN=0, at 3a63301): 317 s, rust_gate.sh 269 s beside
# the other five steps' 302 s, of which the twin suite was 196 s. With the suite once, rust_gate.sh
# carries it and is the long pole; every other step together runs beside it, so 2 still suffices --
# a third slot would have nothing to start.
GOH_CI_JOBS=2
# main moves only through tools/land.sh: a push of a main tip it never gated is refused (BACKLOG 1.5).
GOH_LANDED_ONLY=main

# NO GOH_EXPORT_KEEP (G2c). bin/goh was carried into the pre-push export (2026-10-15) because the
# export held no binary and every native checker said "goh binary not built". That need is gone at
# its root: the export's resolver takes HEAD's build from the stamp-keyed store every checkout
# shares (G2e), and the suite's controller resolves it before a worker starts (tests/_drift_guard.py
# prebuild_live). And the carry was a defect of its own: a kept file's BYTES key the proven cache,
# so the push keyed on a bin/goh built before the commit and the release gate, after the resolver
# replaced it, keyed on HEAD's -- the same tree, a different key, a 3-minute re-run
# (tests/test_proven.py: ..._so_the_release_gate_reuses_the_push).
