# gates_of_heck configuration. All keys optional; delete what you don't use.
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# GOH_LINE_EXCLUDE='third_party/|\.generated\.'
# GOH_PY_COV_MIN=95
# GOH_SWIFT_MODE=xcode            # or spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25           # disk-hygiene ceiling (full runs only)

# The skills-corpus gate over ~/.claude/skills, the corpus this repo's checker
# exists for. It was wired here when that corpus had no repo of its own ("if it
# is not wired here it is wired nowhere"). It now has one, gated by its own
# pre-commit hook -- which, since 2026-09-23, checks the INDEX at --staged.
#
# The corpus is no part of any commit HERE, so pre-commit skips it by name
# ("outside this repo ... NOT checked at --staged"): a violation there could
# only ever be a false red on a gates_of_heck diff, and it was one -- other
# sessions' unstaged skill edits blocked commits here. --full reads the corpus
# at its last COMMIT (it is its own repository), so a push here says when the
# corpus's committed state is broken -- never another session's edit in progress.
GOH_SKILLS_CORPUS=1

# No process kill by name (`goh kill-by-name`). The CadGoose profiling
# scripts and the release kit's update_dev.sh still kill by name; they are in
# kill_by_name_allow.json as `unreviewed`, with the gate's own pattern as the
# one `legitimate` entry.
GOH_NO_KILL_BY_NAME=1

# This tree is public: no private repository is named in it (`goh private-names`, GOH.FINANCENAMES).
# The list of names is the owner's private store's `private_names.txt`, never this tree.
GOH_NO_PRIVATE_NAMES=on

# Every goh temp, lock and stage path comes from lib/run_path.sh (and its Python and Rust faces),
# rooted outside the work tree; a new one minted in a tree is red (`goh run-paths`,
# run_paths_seed.json, GOH.CLASS.CHECKOUT part 2).
GOH_RUN_PATHS=on

# No early-exit consumer on a pipe under pipefail (`goh early-exit-pipe`). The step runs in every
# repo with the ratchet open (a NEW racy pipe refused at commit); this repo's tree is clean, so it
# closes the ratchet and every finding fails.
GOH_NO_EARLY_EXIT_PIPE=1

# Every process call declares its stdin (`goh subprocess-stdin`). This repo owns the check and
# carried half the estate's findings (511 of 996, 2026-10-09); every call now names `stdin=` or
# `input=`, with no allowlist, so it opts in ahead of the default flip (BACKLOG 3.4). The floor is
# the fourth vacuous pass: 614 calls were read on 2026-10-13, and a scan that stops seeing them is
# red rather than clean.
GOH_SUBPROCESS_STDIN=on
GOH_SUBPROCESS_STDIN_MIN_CALLS=550

# Every tracked JavaScript source parses (`goh js-syntax`). This tree holds no JavaScript, so the
# step says "not applicable" here -- and says it, rather than passing silently, which is the point
# of the key: a repository that DOES carry JavaScript writes `on` and gets the check. The two
# engines are `node --check` and macOS's JavaScriptCore; the second one needs nothing installed.
# No floor here: there is no subject to floor (0 files is the whole of it).
GOH_JS_SYNTAX=on

# The decision ledger is whole (`goh decisions`): every docs/decisions record carries its seven
# fields and every `Lives in` path is still tracked, so a deleted path a ruling names is red.
GOH_DECISIONS=on

# Every scanner's floor (BACKLOG 4.3, crates/goh/src/subject.rs): a full-scope scan that reads
# less than this is red, because a scan that stopped reading its subject reports clean. Set at
# about nine tenths of what each read on 2026-10-13 (in brackets), as the stdin floor above is:
# a file or two deleted is not a red gate, a filter or parser that stopped matching is. Lower one
# with the tree in the same commit. checkout-credentials reads ONE file here (the composite action
# .github/actions/goh-floors/action.yml; the repo has no workflows), so its floor is 1 -- the
# whole subject, not nine tenths of it: a scan that reads that file and no longer sees it is red.
GOH_EMOJI_MIN_FILES=570                 # [637] text files
GOH_CONFLICT_MARKERS_MIN_FILES=570      # [637] files
GOH_FILE_LENGTH_MIN_FILES=520           # [582] files measured
GOH_SECRETS_MIN_FILES=570               # [637] text files
GOH_SHELL_LINT_MIN_FILES=60             # [70] shell files
GOH_BUSY_LOOP_MIN_FILES=60              # [68] shell sources the busy-loop check reads
GOH_EARLY_EXIT_PIPE_MIN_FILES=65        # [75] shell sources
GOH_DEAD_AFTER_EXEC_MIN_FILES=65        # [75] shell sources
GOH_BARE_HOOK_INDEX_MIN_FILES=65        # [75] shell sources
GOH_BARE_PYTHON_MIN_FILES=5             # [6] hook/gate scripts
GOH_RELEASE_QUIET_MIN_FILES=2           # [2] release-named shell scripts (2026-11-08)
GOH_MKTEMP_PORTABLE_MIN_FILES=78        # [87] shell sources (2026-11-08)
GOH_LOCALE_PREFIX_MIN_FILES=119         # [133] bash sources: the shell sources less zsh (2026-11-22)
GOH_BARE_OPEN_MIN_FILES=78              # the same shell sources as mktemp-portable (2026-11-13)
GOH_RUN_PATHS_MIN_FILES=410             # [461] shell, Python and Rust sources (2026-11-15)
GOH_GIT_DEADLINE_MIN_FILES=240          # [~274] non-test shell and Python sources (2026-11-14)
GOH_DEAD_PORT_MIN_FILES=580             # [647] test sources (2026-11-15)
GOH_PLURAL_HEDGE_MIN_FILES=720          # [~800] py/sh/rs/swift sources (2026-11-09)
GOH_TAP_WRITES_MIN_FILES=370            # [414] script/workflow files (2026-10-17)
GOH_WORKFLOW_PINS_MIN_REFS=5           # [5] runner labels and action references (2026-11-11)
GOH_MOVING_TAGS_MIN_REFS=0              # [0] image references -- this tree builds and pulls no image
GOH_MD_LINKS_MIN_LINKS=1                # [1] markdown links -- this tree cites by path, not link
GOH_CHECKOUT_CREDENTIALS_MIN_FILES=1    # [1] workflow/action files (2026-10-26)
GOH_UNREAPED_SPAWN_MIN_FILES=300        # [337] test files
GOH_STATUS_MARKERS_MIN_FILES=510        # [568] source files (a GOH_CI_STEPS step)
GOH_INSTALLED_VERSION_MIN_FILES=10      # [11] Markdown files that are not dated history (2026-11-08)
# The one plan (goh roadmap, GOH.ROADMAPGATE): open entries only; today's debt in roadmap_seed.json.
GOH_ROADMAP=docs/BACKLOG.md
GOH_SKILLS_ROOT=$HOME/.claude/skills

# COVERAGE FLOOR for crates/goh: 93.1. Was 95, the house floor, measured 97.91% on
# 2026-09-14 once crates/goh/tests/cli.rs drove the binary end to end over
# fixture repos -- the same exercise the Python parity suites give it from
# pytest, where llvm-cov cannot see it. 2026-11-18 (GOH.SPANFORGIVE): a Rust line is now
# covered only by its own count, no function-span forgiveness; the honest figure is 93.10%
# (26352/28304 lines), floor set to it rounded down (owner ruling "Yes, ratchet"), test-up
# filed. Ratchet: up only.
GOH_COV_FLOOR_RUST=93.1
# The second cfg goh ships (house rule 3: macOS arm64 and Linux x86_64); its std is in
# rust-toolchain.toml. Measured 2026-11-11: 11.7 s, clean (GOH.LANDGAPS).
GOH_RUST_LINT_CONFIGS='--target x86_64-unknown-linux-gnu'
# The cargo that cross-lints it (GOH.VERDICTDB V2). goh's own crates carry C since rusqlite's
# `bundled` SQLite: a --target clippy runs libsqlite3-sys's build script, which compiles
# sqlite3.c FOR LINUX, and this Mac's cc has no Linux libc headers ("'stdio.h' file not found",
# measured 2026-11-24, exit 101). zig cc brings glibc's, so the Linux half is still checked, the
# same clippy over the same cfg, and its C is compiled for Linux too. Measured: 13 s, clean.
GOH_RUST_LINT_CARGO=cargo-zigbuild
# The native checks' behaviour suite is the pytest suite (Phase N3: it drives `goh` from outside
# cargo test), so the coverage gate also runs it against the INSTRUMENTED binary and counts it.
# Without it the crate read 62.5% (2026-10-06) for code the suite covers. GOH_COV_GOH: a test
# driving goh through a gate script gets the same instrumented build (gates/_goh_bin.sh), so its run
# leaves a profile too (GOH.COVGOHBIN: 635 tests had none, and lib/bin_reach.py chose them always).
GOH_COV_RUST_EXTERNAL='GOH_TEST_BIN="$GOH_COVERAGE_BIN_DIR/goh" GOH_COV_GOH="$GOH_COVERAGE_BIN_DIR/goh" ./tools/pytest.sh'
# What no Rust test reads (GOH.GATEFLOOR): the land's `cargo test (plain)` is keyed on the tree minus
# these git globs (gates/_rust_inputs.sh `tests`), so a land of the Python suite, docs or changelog
# alone skips its 41-69 s. Not lib/ nor tools/: goh's Rust tests run goh's own scripts (GOH_DIR is the
# checkout; cli_signal runs `goh land`). tests/test_rust_gate_floor.py refuses a Rust source naming one.
GOH_RUST_TEST_UNREAD='tests/**/*.py docs/** changelog/**'

# A number in prose, re-derived from the tree (`goh claim-derivation`). Opt-in
# in every repo because it lands RED wherever it lands first: three adversarial
# reviews of the games estate found the same class six times (a docstring claiming
# "64 declared gates" against 70, a gate claiming "477 lines and 18 tests" for
# 321 and 20), every one of them found by hand at hours each.
#
# This repo opts in, and the claim it polices is its OWN: `checks/_retired.py`'s
# docstring marks how many forwarders `SHIMS` holds, and this step re-derives it
# (the claim moved there when Phase N3 deleted the Python checker that carried it).
GOH_CLAIM_DERIVATION=1

# The gate of record. `tools/gate.sh --full` (the pre-push hook) delegates to
# gates/local_ci.sh, which reads this -- ONE list. This repo IS the gates, so
# its list is the house Rust gate over crates/goh (whose biting cargo audit reads goh's locked
# copy of the advisory database -- a second, bare `cargo audit` step here refreshed the shared
# one under the test suite's reads and tore them, 2026-10-12), the structural gates over itself,
# cargo test, and the pytest suite (which is what stands between a gate bug and every consumer;
# parallel under xdist with --dist loadgroup, see docs/contracts.md) -- the last two inside the
# Rust gate's coverage group, once (below).
export GOH_DIR="${GOH_DIR:-$HOME/Projects/gates_of_heck}"
# Python shape, decided by a DECLARED rule set: pyproject.toml pins ruff's
# line-length to 100 (matching rustfmt.toml). Opt-in for every repo; this
# one has chosen its rule set, so it opts in. Without a configuration ruff
# applied defaults and the shape of each file was decided by whichever hand
# last edited it -- and no gate here ever ran the check over this tree.
GOH_PYTHON_FORMATTED=1
# THE HOUSE RUFF SET (RUFF.RULES, gates/ruff_house.py): this tree's own rules plus the house's, each
# file held to its ceiling in tools/py_lint_ceilings.json, seeded 2026-11-11 and only allowed to
# fall. The push runs it over every tracked .py (`py_staged.sh --all`, which replaced a bare
# `ruff check .` that judged this tree's rules alone).
GOH_PY_LINT_CEILINGS=tools/py_lint_ceilings.json
# ...and this tree's OWN ruff config selects that set (GOH.LINTPARITY): `ruff check` typed by hand
# judges the rules the gate judges, so a finding is not first seen at commit.
GOH_RUFF_CONFIG_PARITY=on
# THIS repo is the gates, so every step names ITS OWN tree (./), never $GOH_DIR: the push runs in
# a worktree of the pushed commit, and GOH_DIR there is the shared checkout's HEAD export (C4) --
# the v0.22.0 push ran that export's tests, outside any git repo (tests/test_gates_from_head.py).
# The structural gate gives one verdict however the tree's path is spelled (gates/path_invariance.py):
# the push gate runs it from a scratch export under /var/folders, which is also /private/var/folders.
# THE SUITE RUNS ONCE PER GATE (G2e, 2026-10-25). It ran TWICE side by side: as its own step, and
# inside rust_gate.sh's coverage group over the instrumented binary (GOH_COV_RUST_EXTERNAL above),
# which is the same suite, the same tests, judged the same way -- a failing test there is a missing
# coverage part and a red step (tests/test_coverage_external.py). So that run IS the suite step,
# and `cargo test --workspace` likewise: the coverage group runs every lib, bin and test target of
# the workspace with --all-features, which leaves only doctests, run here on their own (`--doc`).
# checks/_calibration.py's runs_pytest() counts the coverage route, so a test cited as a proof is
# still a proof that runs on every push (tests/test_suite_runs_once.py pins the list's shape).
# THE RELEASE CANARY (GOH.CANARY): every consumer runs this checkout's HEAD at its next push, so
# main moving IS the release to the estate. v0.57.4 tightened the shell lint and eight consumers
# refused every push for five days. The last step replays the native gates of the last release and
# of this commit over every registered consumer and refuses while one goes from green to red,
# naming the repo and its seed (scripts/release_canary.py, tests/test_release_canary.py). It is a
# step of THIS list so tools/land.sh runs it before main moves, and the push runs it again.
# THE LOCK ORDER (GOH.LOCKORDER): checks/check_lock_order.py sorts the held-while-acquiring graph of
# every lock goh takes (lib/lock_order.tsv) and refuses a cycle -- the 2026-11-15 ship/land deadlock.
# A SAVED PID (GOH.STRAYSIGNAL): checks/check_saved_pid_kill.py refuses a signal to a pid read from a
# file or kept in a variable with no proof it is still its process (lib/pid_owner.py stamps one).
# THE SHAPE DIFFERENTIAL (GOH.CLASS.SHAPE): a scanner whose sources (or the shape table) changed
# since main runs beside a plain grep for its token over this tree and the estate; a hit it does
# not judge that crates/goh/src/shapes/table.rs does not name is red (from 2026-11-23, the grace).
# It runs where a scanner lands (tools/land.sh); with no estate on the machine (CI) it says
# UNSCOPED and judges nothing.
# THE SETTINGS PROOF (GOH.SETTINGPROOF): checks/check_setting_proof.py refuses a commit of main..HEAD
# whose diff touches the settings surface (QoS, worker counts and shares, gate slots, PRE_SLOTS: its
# SURFACE) without `Reading-lands:` and `Reading-lanes:` trailers, each a before and an after on the
# same quiet line -- a utility clamp slowed lanes x9-25 for days while only lands were read. The
# commit-msg layer (tools/commit_msg.sh) asks first; this step is where `--no-verify` ends.
GOH_CI_STEPS='./gates/rust_gate.sh:./gates/structural.sh --full:cargo test --workspace --doc --locked:./gates/goh.sh status-markers:./gates/goh.sh shape-diff . --estate --since main:./gates/py_staged.sh --all .:"$GOH_PY" ./gates/path_invariance.py -- ./gates/structural.sh --full:"$GOH_PY" ./checks/check_lock_order.py .:"$GOH_PY" ./checks/check_saved_pid_kill.py .:"$GOH_PY" ./checks/check_setting_proof.py range main .:"$GOH_PY" ./scripts/release_canary.py'
# How many of those steps run at once. Serial is the default because only a repo can say which of
# its steps write the same file, so each candidate here was CLOSED rather than assumed (measured
# 2026-10-16):
#   * ADVISORY DATABASE: not shared. `lib/advisory_db.py` gives every goh audit a copy of its own
#     (`GOH_ADVISORY_DB`) under a flock -- shared to read, exclusive to refresh -- so a refresh
#     waits for readers and readers wait for it. The 2026-10-12 tear came from a SECOND, BARE
#     `cargo audit` step here, which is no longer in the list above; every audit this list still
#     runs goes through that seam, so none of them can tear another.
#   * `crates/goh/target`: cargo locks it itself, so rust_gate.sh, `cargo test --workspace --doc`
#     and the coverage sub-step serialise on it by themselves, with no tag to declare.
#   * the two `./gates/structural.sh --full` runs: the second is path_invariance.py's, and it
#     clones HEAD into its own `tempfile.mkdtemp()` and runs there, never in this tree.
# Measured with GOH_PROVEN=0 (so no step could be skipped) and GOH_TIMINGS on, twice, at HEAD:
# 210 s serial, 176 s at 2, 158 s at 4, green throughout, and the 176/158 pair reproduced within
# 3 s in both sweeps. A serial arm measured at 243 s is NOT used -- the box still carried unrelated
# load for it. 2 is the knee: it takes 65% of the saving, and 4 buys 10% more for twice the peak
# load. Note the steps themselves get SLOWER under concurrency and the wall is still lower: the
# pytest suite runs 85 s alone and 142 s beside the twin this list gave it.
# Re-measured for G2e (2026-10-25, GOH_PROVEN=0, at 3a63301): 317 s, rust_gate.sh 269 s beside
# the other five steps' 302 s, of which the twin suite was 196 s. With the suite once, rust_gate.sh
# carries it and is the long pole; every other step together runs beside it.
# 3 since GOH.GATEFLOOR (2026-11-22): a land's gate is ten steps now, and at 2 the canary (100 s
# median), path_invariance (29 s), the doctests and the structural pass queued behind ONE slot beside
# rust_gate.sh. The cores are there: 16, of which the land path takes 3/4 (GOH.LANDSHARE) -- 12 split
# over at most a gate and a pre-step, so a land gate's share is 6-12 -- and the third slot's steps are
# 1-4 cores each (the canary's own JOBS is 4) beside rust_gate.sh's suite, sized by that same share.
GOH_CI_JOBS=3
# main moves only through tools/land.sh: a push of a main tip it never gated is refused (BACKLOG 1.5).
GOH_LANDED_ONLY=main
# Before the land lock and the gate, tools/land.sh runs the tests the diff chooses (GOH.TREETESTSFIRST):
# every test naming a changed path or importing a changed module, and every tree reader -- the structural
# gates and the tree readers FIRST, so a deadline on the rest never swallows them (GOH.PREPARITY). $1 is main's tip.
GOH_LAND_PRE='"$GOH_PY" tools/affected_tests.py --run --structural --rust-cov --base "$1"'
# `goh land --check WORKTREE`, and every `goh land --enqueue --land` before its pre-step, runs these
# land-gate steps (each verbatim one of GOH_CI_STEPS) beside the declared guard tests, in seconds
# (GOH.LANDCHECK, lib/land_check.py): the structural gate, lint as the gate runs it, the lock order,
# the saved-pid probes -- what refused lands after a 200-900 s pre-step, refused before it.
GOH_LAND_CHECK_STEPS='./gates/structural.sh --full:./gates/goh.sh status-markers:./gates/goh.sh shape-diff . --estate --since main:./gates/py_staged.sh --all .:"$GOH_PY" ./checks/check_lock_order.py .:"$GOH_PY" ./checks/check_saved_pid_kill.py .:"$GOH_PY" ./checks/check_setting_proof.py range main .'
# ...and a `--no-pre` enqueue, whose skipped pre-step ran the Rust lint, runs these too (GOH.NOPREBATCH:
# GOH.NITS3's clippy finding went unchecked into a batch and took it down), its coverage deferred.
GOH_LAND_NOPRE_STEPS='./gates/rust_gate.sh'

# NO GOH_EXPORT_KEEP (G2c). bin/goh was carried into the pre-push export (2026-10-15) because the
# export held no binary and every native checker said "goh binary not built". That need is gone at
# its root: the export's resolver takes HEAD's build from the stamp-keyed store every checkout
# shares (G2e), and the suite's controller resolves it before a worker starts (tests/_drift_guard.py
# prebuild_live). And the carry was a defect of its own: a kept file's BYTES key the proven cache,
# so the push keyed on a bin/goh built before the commit and the release gate, after the resolver
# replaced it, keyed on HEAD's -- the same tree, a different key, a 3-minute re-run
# (tests/test_proven.py: ..._so_the_release_gate_reuses_the_push).
# What `tools/release-kit/release.sh` runs before it tags, when no --gate is passed (GOH.SHX2):
# goh's own full gate, so a bare release of goh is gated rather than refused.
GOH_RELEASE_GATE="tools/gate.sh --full"
# goh ship releases goh through its own kit (GOH.SHIPKIT): cut, land, push, tag. It pushes.
GOH_SHIP_RELEASE='tools/release_goh.sh {version}'
# ... and asks the kit's release commit of its land's gate BEFORE the suite (GOH.SHIPEARLY): a
# release text the structural gate refuses is refused in seconds, not after the suite, and the
# green is recorded for that tree, so the release land reuses it.
# Then the consumers an owner's unpushed commit holds back are named, never refused (GOH.PINSWEEP):
# the release's pin waits there for that owner's push, so the push belongs before the ship.
GOH_SHIP_PREFLIGHT='tools/release_goh.sh --preflight {version} && { bin/goh wf-pin --owners || true; }'
# goh's version IS its tag (lib/goh_version.sh, GOH.SHIPRELREUSE): no file a build reads names it,
# so a pushed release tag is held to the stanza its own commit cut, CHANGELOG.md's newest heading.
GOH_TAG_VERSION_SOURCES='changelog:CHANGELOG.md'
GOH_SHIP_RELEASE_PUSHES=1
# goh's land gate carries test verdicts across trees (tests/_land_verdicts.py, GOH.VERDICTCARRY), so
# a release needs a suite run that judged every test on the tip's tree itself (lib/reuse.py full-suite).
GOH_SHIP_FULL_SUITE=on
# COVERAGE IN DUMMY MODE (GOH.COVOFFLAND, owner 2026-11-19): a land never measures coverage (it runs
# the tests plain) and the ship's instrumented run is the only measurement. OFF: the ship measures.
# TO TURN IT ON (coverage measured nowhere, every `goh ship` refused, "coverage in dummy mode; no
# release"): add the line GOH_SHIP_COVERAGE=dummy here; delete it to turn coverage back on.
# The release commit's push re-runs only what its land ran: release files only on a parent whose land
# was green (goh-landed) runs the structural gate and the release files' readers (lib/release_gate.py).
GOH_PUSH_RELEASE_REUSE=on
# Then each consumer workflow's goh pin moves to the release just pushed (GOH.WFPIN): one commit per
# repo through its own hooks, never a push of another repo.
GOH_SHIP_INSTALL='tools/ship_install_goh.sh'
# Its kit cuts CHANGELOG.md with changelog_cut.py, so goh ship asks that contract at start
# (GOH.SHIPCHANGELOG).
GOH_SHIP_CHANGELOG=cut
# Each change's changelog entry is its own file, changelog/<ITEM-ID>.md, folded into the stanza the
# release cuts; the commit gate keeps CHANGELOG.md's Unreleased empty (GOH.CLASS.CHECKOUT part d:
# every lane land of 2026-11-14 conflicted on the one stanza they all wrote).
GOH_CHANGELOG_FRAGMENTS=on
# THE STARVATION BOUND of the gate slots' queue (GOH.SLOTPRIORITY, lib/gate_lanes.py): slots go by
# class (land, ship, lane, work) then age, and a waiter older than this many minutes goes ahead of
# every class, so a sweep or another repo's gate waits behind lands for at most this long. 15: a
# land gate's ~12 min and a margin -- one land ahead, never a stream of them.
GOH_GATE_SLOT_STARVE_MIN=15
# THE LAND PATH'S SHARE of the cores (GOH.LANDSHARE, lib/land_share.py): while a land's pre-step,
# pre-land, gate or a ship is admitted, those runs split this fraction of the cores and every other
# gate splits the rest (at least 1 each); with none admitted every gate gets cores // admitted.
# 0.875: 14 of 16, the lanes' 2 at default QoS (GOH.QOSCLAMP: beside 2 unclamped lane workers a
# 12-worker land-like job ran within 10% of its wall beside clamped ones, beside 4 it ran +26%).
GOH_LAND_SHARE=0.875
