# gates_of_heck configuration. All keys optional; delete what you don't use.
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# GOH_LINE_EXCLUDE='third_party/|\.generated\.'
# GOH_PY_COV_MIN=95
# GOH_SWIFT_MODE=xcode            # or spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25           # disk-hygiene ceiling (full runs only)

# The skills-corpus gate, run from HERE because nothing else can. The corpus at
# ~/.claude/skills is a global asset with no repo of its own, and this is the
# repo that owns the checker -- so if it is not wired here it is wired nowhere,
# and a gate nobody runs is indistinguishable from a gate that passes. That is
# the exact class check_skills_corpus.py was written to catch, and it was true
# of the checker itself until this line existed.
#
# NOTE the coupling this creates: a commit HERE can now fail because a file
# under ~/.claude/skills is mid-edit. That is deliberate -- the alternative is a
# corpus nothing ever checks -- but it is the reason a commit may go red for a
# reason that has nothing to do with the diff.
GOH_SKILLS_CORPUS=1
GOH_SKILLS_ROOT=$HOME/.claude/skills

# COVERAGE FLOOR for crates/goh: 42, measured 42.59% on 2026-09-14 and stated
# rather than quietly left unset. The binary's real exercise is the Python
# parity suites (tests/test_goh_*_parity.py drive the built binary against
# the Python checkers on fixture repos), and cargo-llvm-cov does not see a
# process pytest spawns -- so this number is the Rust UNIT tests alone. It is
# a ratchet: up only. Raising it honestly means either unit tests over the
# per-check modules or an instrumented binary under the parity suites.
GOH_COV_FLOOR_RUST=42

# The gate of record. `tools/gate.sh --full` (the pre-push hook) delegates to
# gates/local_ci.sh, which reads this -- ONE list. This repo IS the gates, so
# its list is the house Rust gate over crates/goh, a biting cargo audit, the
# structural gates over itself, cargo test, and the pytest suite (which is
# what stands between a gate bug and every consumer; parallel under xdist
# with --dist loadgroup, see docs/contracts.md).
export GOH_DIR="${GOH_DIR:-$HOME/Projects/gates_of_heck}"
GOH_CI_STEPS='"$GOH_DIR/gates/rust_gate.sh":cargo audit --deny warnings --deny unmaintained --deny unsound --deny yanked:"$GOH_DIR/gates/structural.sh" --full:cargo test --workspace:"$GOH_DIR/tools/pytest.sh"'
