# gates_of_heck configuration. All keys optional; delete what you don't use.
# Full reference: docs/config.md in the shared checkout.
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# GOH_EXCLUDE='vendor/|\.generated\.'   # shared vendor/generated exemption
# GOH_LINE_EXCLUDE='third_party/'       # length-only exemption (additive)
# GOH_ALLOW=''                          # extra permitted characters (keep minimal)
# GOH_COMMIT_CLASS=1                    # a fix/perf commit names its Class + Siblings (trailers);
#                                       # a third instance of a class says how it ends it
# GOH_CLAIM_DERIVATION=1                # re-derive MARKED numbers in prose from the
#   tree: `N` lines in `path`, `N` tests in `path`, `N` gates in `path:NAME`,
#   `N` `*.ext` files under `dir`. A claim is read only when the number AND the
#   path are backticked, or the line carries a leading `claim:`; every finding
#   prints the command that re-derives the truth. Land it ONCE your claims are
#   marked or fixed: it goes red wherever it lands first, because the defect it
#   finds is everywhere. Survivors go in claim_derivation_allow.json with a
#   reason, and a stale entry fails.
# Disk ceilings live OUTSIDE the gates since v0.8.0 — set them in the
# environment for ~/Projects/scripts/bin/disk_hygiene.sh, not here:
# GOH_MAX_SCRATCH_GB=25 GOH_MAX_CACHE_GB=50 GOH_MIN_FREE_GB=20
# GOH_WATCH_PATHS='' GOH_SCRATCH_ROOTS=''
# GOH_PY_COV_MIN=95
# GOH_PY_RUNNER="uv run"          # toolchain prefix (whitespace-split)
# GOH_SWIFT_MODE=xcode            # or spm (default: spm if Package.swift exists)
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_PROJECT=MyApp.xcodeproj   # required when several .xcodeproj exist
# GOH_SWIFT_COV_MIN=95
# GOH_SWIFT_COLD=1                # 1 wipes .build first (default); 0 = incremental
# GOH_SWIFT_LINT_BASELINE=''      # shrink-only swiftlint ratchet (unset = strict)
# GOH_COV_FLOOR_RUST=95           # or _SWIFT / _CPP / _PY; --floor flag beats these
# GOH_COV_FLOORS_JSON=''          # per-target + per-file floors file
# GOH_COV_INCLUDE_RE=''           # positive filter, applied before --ignore
# GOH_COV_MARKER_CEILING=''       # cap on cov:ignore forgiven lines (shrink-only)
# GOH_COV_SWIFT_ENGINE=spm        # or xcodebuild (swift coverage only)
# GOH_COV_SCHEME=''               # scheme for the xcodebuild coverage engine
# GOH_COV_DD=.build/xcode-dd      # derived-data dir holding the profdata
# GOH_COV_XCRESULT=''             # existing xcresult path (skips the test run)
# GOH_CPP_BUILD_DIR=build-cov
# GOH_CPP_TEST_BIN=''             # required when several test binaries exist
# GOH_CTEST_ARGS=''               # extra ctest selection, verbatim
# GOH_CI_STEPS='./tools/repo_gates.sh'  # colon-separated; keep colons out of steps
# GOH_RUST_JOBS=4                   # crates at once under rust_gate.sh --each-crate
# GOH_CI_JOBS=4                     # run that many steps at once (default 1); '[tag] cmd' steps sharing a tag never overlap
# GOH_RELEASE_GATE='./tools/gate.sh --full'
# GOH_TAG_VERSION_SOURCES='file:VERSION cargo:Cargo.toml'   # what a pushed v<semver>
#   tag must match, read at the tagged COMMIT. Scope a glob to what you ship
#   (cargo:crates/*/Cargo.toml); **/Cargo.toml sweeps vendor/ and invents
#   findings about crates you do not ship.
# GOH_TAIL=60                     # log lines printed on step failure

# Per-step wall-clock CEILINGS, and they are ON by default (GOH_LCI_TIMEOUT 900s for a
# local_ci step, GOH_STEP_TIMEOUT 1800s for a toolchain gate's goh_step). Both are printed on
# every run and both sweep the step's whole process group on expiry, naming what they swept.
# media_server, 2026-10-03: a leaked server held the cargo build lock, every later `cargo
# test` blocked, and nothing said why -- because the run that would have reported it was the
# run that had been killed. Raise these when a step genuinely needs longer; 0 opts OUT and says
# so on the step line rather than looking identical to a bounded step.
# GOH_LCI_TIMEOUT=1800
# GOH_STEP_TIMEOUT=3600
# GOH_STEP_GRACE=5
