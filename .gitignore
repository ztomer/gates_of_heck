__pycache__/
.DS_Store
.opencode/
*.pyc

# Rust build output (builds normally use the shared CARGO_TARGET_DIR;
# a repo-local target/ must never be committed)
/target/

# bin/ is build output only, ignored WHOLE (GOH.BUILDLOCKIGNORE): the native binary install.sh builds
# (bin/goh), every build by its source stamp (bin/by-stamp/, gates/_goh_bin.sh), a placement's stage
# `<dest>.<pid>.staging` a copy killed mid-way leaves (lib/place.sh, GOH.STAGINGSTRAY), and the
# builders' lock bin/.build.lock/ a killed build leaves (scripts/build-goh.sh). Named one at a time,
# the lock was missed and read as `?? bin/`; nothing under bin/ is ever tracked
# (tests/test_build_lock_ignored.py).
/bin/

# The land root: tools/land.sh runs from a linked worktree under build/<name>, and an open one must
# not read as an uncommitted main checkout (tests/test_land_root_ignored.py).
/build/
/.claude/worktrees/
